DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/event_vault
AUTH_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
SEAT_LOCK_TTL_SECONDS=300
REDIS_HOST=localhost
REDIS_PORT=6379
WAITING_ROOM_ADMISSION_LIMIT=25
WAITING_ROOM_ADMISSION_TTL_SECONDS=600
WAITING_ROOM_MAX_QUEUE_SIZE=5000
WAITING_ROOM_QUEUE_TTL_SECONDS=86400
WAITING_ROOM_STATE_TTL_SECONDS=86400
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=eventvault
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
